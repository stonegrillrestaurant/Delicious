rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSystemOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "courtsidegatherings@gmail.com";
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (
          isSystemOwner()
          || request.auth.token.email == "ninoxx@gmail.com"
        );
    }

    function isStaff() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == "r4UwTxOgiKcEkHimmlAkVVlUJMt1";
    }

    function isOperator() {
      return isAdmin() || isStaff();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasLivePanelControl() {
      return isOperator()
        && exists(/databases/$(database)/documents/adminSessions/livePanel)
        && get(/databases/$(database)/documents/adminSessions/livePanel).data.activeUid == request.auth.uid
        && get(/databases/$(database)/documents/adminSessions/livePanel).data.leaseUntil > request.time;
    }

    // Private customer profile.
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.keys().hasOnly([
            "uid", "displayName", "email", "photoURL",
            "communityVisible", "createdAt", "updatedAt"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "displayName", "photoURL",
              "communityVisible", "updatedAt"
            ])
        );

      allow delete: if isAdmin();
    }

    // Privacy-safe community leaderboard/profile.
    match /communityProfiles/{uid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public schedule: no customer email/phone/payment data here.
    match /publicSchedule/{scheduleId} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          isStaff()
          && request.resource.data.source == "admin_schedule"
          && request.resource.data.status == "confirmed"
          && request.resource.data.courtId is int
          && request.resource.data.date is string
          && request.resource.data.startTime is string
          && request.resource.data.endTime is string
          && (
            request.resource.data.type == "open_play"
            || (
              request.resource.data.type == "private"
              && request.resource.data.bookingType == "private_rental"
            )
          )
        )
        || (
          signedIn()
          && request.resource.data.type == "private"
          && request.resource.data.bookingType == "private_rental"
          && request.resource.data.status == "pending_payment"
          && request.resource.data.bookingId == scheduleId
          && request.resource.data.customerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/privateRentalBookings/$(scheduleId))
               .data.customerUid == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          isStaff()
          && resource.data.source == "admin_schedule"
          && request.resource.data.source == "admin_schedule"
          && request.resource.data.status == "confirmed"
          && request.resource.data.courtId == resource.data.courtId
          && request.resource.data.date is string
          && request.resource.data.startTime is string
          && request.resource.data.endTime is string
          && (
            request.resource.data.type == "open_play"
            || (
              request.resource.data.type == "private"
              && request.resource.data.bookingType == "private_rental"
            )
          )
        )
        || (
          signedIn()
          && resource.data.type == "private"
          && resource.data.holdUntil > request.time
          && getAfter(/databases/$(database)/documents/privateRentalBookings/$(scheduleId))
               .data.customerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/privateRentalBookings/$(scheduleId))
               .data.status == "pending_verification"
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status"])
          && request.resource.data.status == "pending_verification"
        );

      allow delete: if isAdmin()
        || (
          isStaff()
          && resource.data.source == "admin_schedule"
        )
        || (
          signedIn()
          && resource.data.type == "private"
          && resource.data.status == "pending_payment"
          && resource.data.customerUid == request.auth.uid
        );
    }

    // Actual Open Play session definition + privacy-safe public capacity counter.
    // The customer booking page may read joinedPlayers/maxPlayers, but only an
    // authorized admin workflow may create or change the session. Manual walk-ins
    // and verified online players update joinedPlayers through admin-authenticated
    // pages; customers never write this counter directly.
    match /openPlaySessions/{sessionId} {
      allow read: if true;

      // Admin may manage all sessions. Staff may create/delete only sessions
      // published from the authorized Live Panel court configuration.
      allow create: if isAdmin()
        || (
          isStaff()
          && request.resource.data.source == "admin_schedule"
          && request.resource.data.type == "open_play"
          && request.resource.data.status == "active"
          && request.resource.data.sessionId == sessionId
          && request.resource.data.courtId is int
          && request.resource.data.date is string
          && request.resource.data.startTime is string
          && request.resource.data.endTime is string
          && request.resource.data.maxPlayers >= 1
        );

      allow delete: if isAdmin()
        || (
          isStaff()
          && resource.data.source == "admin_schedule"
        );

      allow update: if isAdmin()
        || (
          isStaff()
          && (
            (
              resource.data.source == "admin_schedule"
              && request.resource.data.source == "admin_schedule"
              && request.resource.data.type == "open_play"
              && request.resource.data.sessionId == sessionId
              && request.resource.data.courtId == resource.data.courtId
              && request.resource.data.maxPlayers >= 1
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "joinedPlayers", "updatedAt"
              ])
              && request.resource.data.joinedPlayers >= 0
              && request.resource.data.joinedPlayers <= resource.data.maxPlayers
            )
          )
        );
    }

    // Atomic Open Play seat locks. Expired pending-payment locks may be reclaimed.
    match /openPlaySeatLocks/{lockId} {
      // Customers may fetch a specific seat lock during a transaction, but cannot list the collection.
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending_payment"
        && request.resource.data.holdUntil > request.time
        && request.resource.data.holdUntil <= request.time + duration.value(30, "m");

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == "pending_payment"
          && request.resource.data.customerUid == request.auth.uid
          && (
            resource.data.customerUid == request.auth.uid
            || (
              resource.data.status == "pending_payment"
              && resource.data.holdUntil <= request.time
            )
          )
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
            )
            || request.resource.data.status == "pending_verification"
          )
        );

      allow delete: if isAdmin();
    }

    // Customer Open Play joins.
    // Registration/payment state is separate from live queue state. Verification
    // does not write directly to pickleball/currentState; physical check-in remains
    // a separate operations action.
    match /openPlayRegistrations/{registrationId} {
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.status == "pending_payment"
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.reservedPlayers >= 1
          && request.resource.data.holdUntil > request.time
          && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
        );

      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isOperator()
        );

      allow update: if isAdmin()
        || (
          isStaff()
          && resource.data.paymentStatus == "verified"
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "checkedIn", "checkedInAt", "checkedInByUid", "checkedInByEmail",
            "updatedAt"
          ])
        )
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == "pending_payment"
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "paymentStatus", "reservedPlayers",
            "seatLockIds", "holdUntil", "updatedAt"
          ])
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.paymentStatus == "pending"
              && request.resource.data.reservedPlayers >= 1
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
            )
            || (
              request.resource.data.status == "pending_verification"
              && request.resource.data.paymentStatus == "submitted"
            )
          )
        );

      allow delete: if isAdmin();
    }

    // Atomic hourly court locks. These are the concurrency authority for customer rentals.
    match /slotLocks/{lockId} {
      // Customers may fetch a specific hourly lock during a transaction, but cannot list the collection.
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending_payment"
        && request.resource.data.holdUntil > request.time
        && request.resource.data.holdUntil <= request.time + duration.value(10, "m");

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == "pending_payment"
          && request.resource.data.customerUid == request.auth.uid
          && (
            resource.data.customerUid == request.auth.uid
            || (
              resource.data.status == "pending_payment"
              && resource.data.holdUntil <= request.time
            )
          )
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(10, "m")
            )
            || (
              request.resource.data.status == "pending_verification"
              && resource.data.holdUntil > request.time
            )
          )
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == "pending_payment"
        );
    }

    // Actual private-rental booking.
    match /privateRentalBookings/{bookingId} {
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.status == "pending_payment"
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.holdUntil > request.time
          && request.resource.data.holdUntil <= request.time + duration.value(10, "m")
        );

      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isOperator()
        );

      allow update: if isAdmin()
        || (
          isStaff()
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "checkedIn", "checkedInAt", "checkedInByUid", "checkedInByEmail",
            "updatedAt"
          ])
        )
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == "pending_payment"
          && resource.data.holdUntil > request.time
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "paymentStatus", "holdUntil", "updatedAt"
          ])
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.paymentStatus == "pending"
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(10, "m")
            )
            || (
              request.resource.data.status == "pending_verification"
              && request.resource.data.paymentStatus == "submitted"
            )
          )
        )
        // A different customer may reuse the exact same booking ID only after
        // the previous unpaid hold has expired.
        || (
          signedIn()
          && resource.data.status == "pending_payment"
          && resource.data.holdUntil <= request.time
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.bookingType == "private_rental"
          && request.resource.data.status == "pending_payment"
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.holdUntil > request.time
          && request.resource.data.holdUntil <= request.time + duration.value(10, "m")
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == "pending_payment"
          && resource.data.paymentStatus == "pending"
        );
    }

    // Customer payment claim + admin verification.
    // The payment record can only be created after the reservation has been
    // atomically promoted to pending_verification in the same transaction.
    match /paymentSubmissions/{paymentId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending_verification"
        && (
          (
            request.resource.data.bookingType == "private_rental"
            && getAfter(/databases/$(database)/documents/privateRentalBookings/$(request.resource.data.registrationId))
                 .data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/privateRentalBookings/$(request.resource.data.registrationId))
                 .data.status == "pending_verification"
          )
          || (
            request.resource.data.bookingType != "private_rental"
            && getAfter(/databases/$(database)/documents/openPlayRegistrations/$(request.resource.data.registrationId))
                 .data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/openPlayRegistrations/$(request.resource.data.registrationId))
                 .data.status == "pending_verification"
          )
        );

      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    // Customer carried-balance summary. Customers may read their own balance;
    // only Admin may change it after a deliberate payment decision.
    match /customerBalances/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Immutable balance ledger created by Admin payment decisions.
    match /balanceTransactions/{transactionId} {
      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );
      allow create: if isAdmin()
        && request.resource.data.customerUid is string
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // Confirmed attendance/activity. Customers cannot award themselves.
    match /playerActivity/{activityId} {
      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    // Auditable loyalty/reward ledger.
    match /rewardTransactions/{transactionId} {
      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    // Permanent audit trail. Operators can append actions attributed to themselves.
    // Only admins can browse the complete audit history.
    match /eventLogs/{eventId} {
      allow create: if isOperator()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Cumulative "today so far" snapshots. Saving a report never resets transactions.
    match /daySnapshots/{snapshotId} {
      allow create: if isAdmin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Live Panel controller lease. All admins may see who currently controls the panel.
    // Only the current controller may refresh/release their lease; another admin can
    // take control after the previous lease expires.
    match /adminSessions/livePanel {
      allow read: if isOperator();

      allow create: if isOperator()
        && request.resource.data.activeUid == request.auth.uid;

      allow update: if isOperator()
        && request.resource.data.activeUid == request.auth.uid
        && (
          resource.data.activeUid == request.auth.uid
          || resource.data.leaseUntil <= request.time
        );

      allow delete: if isOperator()
        && resource.data.activeUid == request.auth.uid;
    }

    // Operations status only — never the booking authority.
    // Every authorized admin can view it, but only the active Live Panel controller
    // can change live queue/history state.
    match /pickleball/currentState {
      allow read: if isOperator();
      allow write: if hasLivePanelControl();
    }

    // Privacy-safe TV/public display. It contains only court, queue and player
    // display fields written from the authorized Live Panel.
    match /pickleball/publicLive {
      allow read: if true;
      allow write: if hasLivePanelControl();
    }

    match /pickleball/historyVault {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
