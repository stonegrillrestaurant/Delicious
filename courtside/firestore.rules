rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == "courtsidegatherings@gmail.com"
          || request.auth.token.email == "lzl.lopez@yahoo.com"
          || request.auth.token.email == "dod_ong@yahoo.com"
        );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasLivePanelControl() {
      return isAdmin()
        && exists(/databases/$(database)/documents/adminSessions/livePanel)
        && get(/databases/$(database)/documents/adminSessions/livePanel).data.activeUid == request.auth.uid
        && get(/databases/$(database)/documents/adminSessions/livePanel).data.leaseUntil > request.time;
    }

    // Private customer profile.
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.keys().hasOnly([
            "uid", "displayName", "email", "photoURL",
            "communityVisible", "createdAt", "updatedAt"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "displayName", "photoURL",
              "communityVisible", "updatedAt"
            ])
        );

      allow delete: if isAdmin();
    }

    // Privacy-safe community leaderboard/profile.
    match /communityProfiles/{uid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public schedule: no customer email/phone/payment data here.
    match /publicSchedule/{scheduleId} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.type == "private"
          && request.resource.data.bookingType == "private_rental"
          && request.resource.data.status == "pending_payment"
          && request.resource.data.bookingId == scheduleId
          && getAfter(/databases/$(database)/documents/privateRentalBookings/$(scheduleId))
               .data.customerUid == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.type == "private"
          && resource.data.holdUntil > request.time
          && getAfter(/databases/$(database)/documents/privateRentalBookings/$(scheduleId))
               .data.customerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/privateRentalBookings/$(scheduleId))
               .data.status == "pending_verification"
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status"])
          && request.resource.data.status == "pending_verification"
        );

      allow delete: if isAdmin();
    }

    // Actual Open Play session definition.
    match /openPlaySessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Atomic Open Play seat locks. Expired pending-payment locks may be reclaimed.
    match /openPlaySeatLocks/{lockId} {
      // Customers may fetch a specific seat lock during a transaction, but cannot list the collection.
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending_payment"
        && request.resource.data.holdUntil > request.time
        && request.resource.data.holdUntil <= request.time + duration.value(30, "m");

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == "pending_payment"
          && request.resource.data.customerUid == request.auth.uid
          && (
            resource.data.customerUid == request.auth.uid
            || (
              resource.data.status == "pending_payment"
              && resource.data.holdUntil <= request.time
            )
          )
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
            )
            || request.resource.data.status == "pending_verification"
          )
        );

      allow delete: if isAdmin();
    }

    // Customer Open Play joins.
    match /openPlayRegistrations/{registrationId} {
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.status == "pending_payment"
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.reservedPlayers >= 1
          && request.resource.data.holdUntil > request.time
          && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
        );

      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == "pending_payment"
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "paymentStatus", "reservedPlayers",
            "seatLockIds", "holdUntil", "updatedAt"
          ])
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.paymentStatus == "pending"
              && request.resource.data.reservedPlayers >= 1
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
            )
            || (
              request.resource.data.status == "pending_verification"
              && request.resource.data.paymentStatus == "submitted"
            )
          )
        );

      allow delete: if isAdmin();
    }

    // Atomic hourly court locks. These are the concurrency authority for customer rentals.
    match /slotLocks/{lockId} {
      // Customers may fetch a specific hourly lock during a transaction, but cannot list the collection.
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending_payment"
        && request.resource.data.holdUntil > request.time
        && request.resource.data.holdUntil <= request.time + duration.value(30, "m");

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == "pending_payment"
          && request.resource.data.customerUid == request.auth.uid
          && (
            resource.data.customerUid == request.auth.uid
            || (
              resource.data.status == "pending_payment"
              && resource.data.holdUntil <= request.time
            )
          )
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
            )
            || (
              request.resource.data.status == "pending_verification"
              && resource.data.holdUntil > request.time
            )
          )
        );

      allow delete: if isAdmin();
    }

    // Actual private-rental booking.
    match /privateRentalBookings/{bookingId} {
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.status == "pending_payment"
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.holdUntil > request.time
          && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
        );

      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == "pending_payment"
          && resource.data.holdUntil > request.time
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "paymentStatus", "holdUntil", "updatedAt"
          ])
          && (
            (
              request.resource.data.status == "pending_payment"
              && request.resource.data.paymentStatus == "pending"
              && request.resource.data.holdUntil > request.time
              && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
            )
            || (
              request.resource.data.status == "pending_verification"
              && request.resource.data.paymentStatus == "submitted"
            )
          )
        )
        // A different customer may reuse the exact same booking ID only after
        // the previous unpaid hold has expired.
        || (
          signedIn()
          && resource.data.status == "pending_payment"
          && resource.data.holdUntil <= request.time
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.bookingType == "private_rental"
          && request.resource.data.status == "pending_payment"
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.holdUntil > request.time
          && request.resource.data.holdUntil <= request.time + duration.value(30, "m")
        );

      allow delete: if isAdmin();
    }

    // Customer payment claim + admin verification.
    // The payment record can only be created after the reservation has been
    // atomically promoted to pending_verification in the same transaction.
    match /paymentSubmissions/{paymentId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending_verification"
        && (
          (
            request.resource.data.bookingType == "private_rental"
            && getAfter(/databases/$(database)/documents/privateRentalBookings/$(request.resource.data.registrationId))
                 .data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/privateRentalBookings/$(request.resource.data.registrationId))
                 .data.status == "pending_verification"
          )
          || (
            request.resource.data.bookingType != "private_rental"
            && getAfter(/databases/$(database)/documents/openPlayRegistrations/$(request.resource.data.registrationId))
                 .data.customerUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/openPlayRegistrations/$(request.resource.data.registrationId))
                 .data.status == "pending_verification"
          )
        );

      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    // Confirmed attendance/activity. Customers cannot award themselves.
    match /playerActivity/{activityId} {
      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    // Auditable loyalty/reward ledger.
    match /rewardTransactions/{transactionId} {
      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    // Live Panel controller lease. All admins may see who currently controls the panel.
    // Only the current controller may refresh/release their lease; another admin can
    // take control after the previous lease expires.
    match /adminSessions/livePanel {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.activeUid == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.activeUid == request.auth.uid
        && (
          resource.data.activeUid == request.auth.uid
          || resource.data.leaseUntil <= request.time
        );

      allow delete: if isAdmin()
        && resource.data.activeUid == request.auth.uid;
    }

    // Operations status only — never the booking authority.
    // Every authorized admin can view it, but only the active Live Panel controller
    // can change live queue/history state.
    match /pickleball/currentState {
      allow read: if isAdmin();

      // Normal Live Panel operations remain single-controller.
      // Venue check-in is the one exception: any authorized admin may append
      // verified arrivals to players/queues from the Payment Verification page.
      allow create: if hasLivePanelControl()
        || (
          isAdmin()
          && request.resource.data.keys().hasOnly([
            "players", "queues", "courts",
            "totalMatchesPlayed", "dailyRentals", "dailyOpenPlayLogs"
          ])
        );

      allow update: if hasLivePanelControl()
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["players", "queues"])
        );

      allow delete: if hasLivePanelControl();
    }

    match /pickleball/historyVault {
      allow read: if isAdmin();
      allow write: if hasLivePanelControl();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
